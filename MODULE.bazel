module(
    name = "password_manager",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "0.0.10")

# C/C++
bazel_dep(
    name = "rules_cc",
    version = "0.2.17",
)

# Python rules
bazel_dep(
    name = "rules_python",
    version = "1.7.0",
)

# JSON
bazel_dep(
    name = "nlohmann_json",
    version = "3.12.0.bcr.1",
)

# Protobuf
bazel_dep(
    name = "protobuf",
    version = "33.4",
)

# Crypto
bazel_dep(
    name = "libsodium",
    version = "1.0.19",
)

# Ruby (если реально используется)
bazel_dep(
    name = "rules_ruby",
    version = "0.27.0",
)

# Tests
bazel_dep(
    name = "googletest",
    version = "1.17.0.bcr.2",
)

# Compile commands
bazel_dep(
    name = "hedron_compile_commands",
    dev_dependency = True,
)
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)

# Aspect utilities
bazel_dep(
    name = "aspect_bazel_lib",
    version = "2.22.5",
)

bazel_dep(
    name = "rules_go",
    version = "0.59.0",
)

bazel_dep(name = "rules_qt", dev_dependency=True)

git_override(
	module_name = "rules_qt",
	remote = "https://github.com/kklochkov/rules_qt",
	commit = "212c181670e3c8fd8a21a7a58484f506c98446c3",
)

qt = use_extension("@rules_qt//qt:extensions.bzl", "qt")
qt.remote_repo(
    name = "qt5_remote",
    base_url = "https://download.qt.io/archive/qt/5.15/5.15.18/submodules",
    configure_args = [
        "-opensource",
        "-confirm-license",
        "-release",
        "-shared",
        "-nomake",
        "examples",
        "-nomake",
        "tests",
    ],
    # @unsorted-dict-items
    # order matters
    modules = {
        "qtbase-everywhere-opensource-src-5.15.18.tar.xz": "7b632550ea1048fc10c741e46e2e3b093e5ca94dfa6209e9e0848800e247023b",
    },
    prefix = "qt-5.15.18",
)
# See examples/MODULE.bazel for complete configure_args and modules values.

qt.local_repo(
    name = "qt6_local",
    # Single-platform shorthand:
    # path = "/opt/homebrew/opt/qt",
    # Multi-platform:
    paths = {
        "macos-arm64": "/opt/homebrew/opt/qt",
        "linux-x86_64": "/usr/lib/qt6",
    },
)

qt.active_sdk(
    name = "qt",
    repo = "qt6_local",  # or "qt6_local"
)

use_repo(qt, "qt")

# optional: add Qt5 local and switch active SDK
# qt.local_repo(
#     name = "qt5_local",
#     paths = {
#         "macos-arm64": "/opt/homebrew/opt/qt@5",
#         "linux-x86_64": "/usr/lib/x86_64-linux-gnu/qt5",
#     },
# )
# qt.active_sdk(name = "qt", repo = "qt5_local")

register_toolchains(
    "@qt//:qt_linux_x86_64_toolchain",
    "@qt//:qt_linux_arm64_toolchain",
    "@qt//:qt_osx_arm64_toolchain",
)
