QMainWindow {
  background-color: #1a1c23;
}

QWidget {
  color: #e6e7eb;
  font-family: "Inter", "Segoe UI", sans-serif;
}

QToolBar {
  background: #1a1c23;
  border: none;
  spacing: 6px;
  padding: 4px;
}

QToolBar QToolButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 6px 10px;
  color: #c9ccd6;
}

QToolBar QToolButton:hover {
  background: #23262e;
  border-color: #2f333d;
  color: #ffffff;
}

QToolBar QToolButton:pressed {
  background: #1f2229;
}

QListWidget {
  background: transparent;
}

QListWidget::item {
  background: transparent;
  border: none;
  padding: 2px;
}

QListWidget::item:selected {
  background: transparent;
}

QLineEdit {
  background: #1f2229;
  border: 1px solid #2f333d;
  border-radius: 10px;
  padding: 8px 10px;
  color: #e6e7eb;
  selection-background-color: #3b82f6;
  selection-color: #ffffff;
}

QLineEdit:focus {
  border: 1px solid #4f9cff;
}

QLineEdit#search {
  padding: 8px 12px;
  border-radius: 10px;
  background: #1f2229;
  border: 1px solid #2f333d;
}

QLineEdit#search:focus {
  border: 1px solid #4f9cff;
}

QFrame#PasswordCard {
  background: #23262e;
  border: 1px solid #2f333d;
  border-radius: 12px;
}

QFrame#PasswordCard:hover {
  border: 1px solid #3a3f4b;
}

QLabel {
  color: #e6e7eb;
}

QToolButton#eye,
QToolButton#copy {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 4px 8px;
  color: #9aa0b4;
}

QToolButton#eye:hover,
QToolButton#copy:hover {
  background: #2f333d;
  border-color: #3a3f4b;
  color: #e6e7eb;
}

QToolButton#eye:checked {
  color: #4f9cff;
}

QLineEdit#PasswordField {
  background: #1a1c23;
  border: 1px solid #2f333d;
  border-radius: 8px;
  padding: 6px 8px;
  color: #c9ccd6;
}

QDialog {
  background: #1a1c23;
}

QDialogButtonBox QPushButton {
  background: #23262e;
  border: 1px solid #2f333d;
  border-radius: 8px;
  padding: 6px 12px;
  color: #e6e7eb;
  min-width: 80px;
}

QDialogButtonBox QPushButton:hover {
  background: #282b34;
  border-color: #3a3f4b;
}

QDialogButtonBox QPushButton:pressed {
  background: #1f2229;
}

QMessageBox {
  background: #1a1c23;
}
